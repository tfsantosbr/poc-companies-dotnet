### Partners Endpoints
# Authentication is included below - run the auth request first to get a token

### Authenticate
# @name auth
POST {{baseUrl}}/{{apiVersion}}/authentication/token
Content-Type: application/json

{
  "username": "{{username}}",
  "password": "{{password}}"
}

###
# Capture the access token from the response
@access_token = {{auth.response.body.token}}

### List Partners
# Get a list of all partners
GET {{baseUrl}}/{{apiVersion}}/partners
Authorization: Bearer {{access_token}}

###

### Create Partner
# @name createPartner
POST {{baseUrl}}/{{apiVersion}}/partners
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "firstName": "John",
  "lastName": "Doe",
  "email": "john.doe@example.com"
}

###
# Capture the created partner ID
@lastCreatedPartnerId = {{createPartner.response.body.id}}

###

### Remove Partner
# Delete a specific partner (uses the ID captured from Create Partner)
DELETE {{baseUrl}}/{{apiVersion}}/partners/{{lastCreatedPartnerId}}
Authorization: Bearer {{access_token}}
