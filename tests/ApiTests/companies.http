### Companies Endpoints
# These endpoints require authentication. Run authentication.http first to get a token.

@access_token = your-token-here

### Find Companies
# Get a list of all companies
GET {{baseUrl}}/{{apiVersion}}/companies
Authorization: Bearer {{access_token}}

###

### Create Company
# @name createCompany
# CNPJ must be 14 digits, mainActivityId must be valid (e.g., 4399103, 4723700, 4774100, 5611203, 9492800)
# Legal nature options: EIRELI, MEI, LTDA
# Qualification IDs: 5, 10, 16, 22, 54
# Partner IDs (examples): 012af8a2-8de0-45b7-b9c7-dcfdb3b491b3, 1a0592e2-71f0-48cc-8267-0f8d75fe0a5e
POST {{baseUrl}}/{{apiVersion}}/companies
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "cnpj": "12345678901234",
  "name": "Tech Solutions Inc",
  "legalNature": "LTDA",
  "mainActivityId": 4723700,
  "address": {
    "postalCode": "12345",
    "street": "Main Street",
    "number": "100",
    "complement": "Suite 200",
    "neighborhood": "Downtown",
    "city": "São Paulo",
    "state": "SP",
    "country": "Brazil"
  },
  "partners": [
    {
      "partnerId": "012af8a2-8de0-45b7-b9c7-dcfdb3b491b3",
      "qualificationId": 5,
      "joinedAt": "2022-01-01"
    }
  ],
  "phones": [
    {
      "countryCode": "11",
      "number": "987654321"
    }
  ]
}

###
# Capture the created company ID
@lastCreatedCompanyId = {{createCompany.response.body.id}}

###

### Import Companies
# Import multiple companies at once
POST {{baseUrl}}/{{apiVersion}}/companies/import
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "companies": [
    {
      "cnpj": "11111111111111",
      "name": "Company One",
      "legalNature": "EIRELI",
      "mainActivityId": 4399103,
      "address": {
