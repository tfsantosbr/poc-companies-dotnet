###

### Get Valid Company
# Get a specific company by ID (uses the ID captured from Create Company)
GET {{baseUrl}}/{{apiVersion}}/companies/{{lastCreatedCompanyId}}
Authorization: Bearer {{access_token}}

###

### Update Valid Company
# Update a specific company (uses the ID captured from Create Company)
PUT {{baseUrl}}/{{apiVersion}}/companies/{{lastCreatedCompanyId}}
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "name": "Tech Solutions Inc - Updated",
  "legalNature": "LTDA",
  "mainActivityId": 4774100,
  "address": {
    "postalCode": "54321",
    "street": "Updated Street",
    "number": "200",
    "complement": "Suite 300",
    "neighborhood": "Uptown",
    "city": "São Paulo",
    "state": "SP",
    "country": "Brazil"
  },
  "phones": [
    {
      "countryCode": "11",
      "number": "123456789"
    }
  ]
}

###

### Remove Valid Company
# Delete a specific company (uses the ID captured from Create Company)
DELETE {{baseUrl}}/{{apiVersion}}/companies/{{lastCreatedCompanyId}}
Authorization: Bearer {{access_token}}
